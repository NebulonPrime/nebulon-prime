# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=nebulon-prime

# Make this the same as your github username/organisation
REPO_ORGANIZATION="NebulonPrime"

# OS name shown in the boot menu, installer and "About this System"
OS_ID=nebulon-prime
OS_PRETTY_NAME="Nebulon Prime"

# Base image for local builds. CI builds both of these:
#   ghcr.io/ublue-os/aurora:stable              (AMD / Intel)
#   ghcr.io/ublue-os/aurora-nvidia-open:stable  (NVIDIA)
BASE_IMAGE="ghcr.io/ublue-os/aurora:stable"
OS_VARIANT=main

IMAGE_DESC="A private, offline-first, Windows-style desktop built on Fedora Atomic"
IMAGE_KEYWORDS="bootc,oci,linux,kde,wine,windows"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
